{"task_id": "jd_home_search_list", "site": "jd", "goal": "京东首页搜索保温杯进入列表页（搜索/表单）", "steps": [{"cmd": "open", "args": ["https://www.jd.com"]}, {"cmd": "wait", "opts": {"idle": true, "timeout": 20}}, {"cmd": "fill", "args": ["css:input.jd_pc_search_bar_react_search_input", "保温杯"]}, {"cmd": "press", "args": ["Enter"]}, {"cmd": "wait", "opts": {"idle": true, "timeout": 20}, "optional": true}, {"cmd": "sleep", "args": [2]}], "expect": {"kind": "url_contains", "needle": "search.jd.com"}}
