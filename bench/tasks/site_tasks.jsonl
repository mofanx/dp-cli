{"task_id": "m2w_bing_img_scroll_grow", "site": "bing", "goal": "Bing 图片搜索滚动懒加载计数增长断言：单 eval Promise 内 scroll×5+延迟对比 a.iusc 计数（无限滚动增长）", "steps": [{"cmd": "open", "args": ["https://www.bing.com/images/search?q=cat"]}, {"cmd": "wait", "opts": {"idle": true, "timeout": 20}}, {"cmd": "eval", "args": ["return new Promise(function(r){var s='a.iusc';var n0=document.querySelectorAll(s).length;var i=0;var t=setInterval(function(){window.scrollBy(0,1500);if(++i>=5){clearInterval(t);setTimeout(function(){var n1=document.querySelectorAll(s).length;r('CNT '+n0+'->'+n1+(n1>n0?' GROW':' NOGROW'))},3000)}},700)})"], "opts": {"timeout": 40}, "timeout": 60}], "expect": {"kind": "json_field", "path": "data.result", "contains": "GROW"}}
